# ==============================================================================
# DENTIST ON CALL CAIRO — SUPABASE & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in the repository root and fill in your Supabase project keys.
# Project Dashboard: https://supabase.com/dashboard/project/<your-project-id>

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Note: For transaction pooling (recommended for serverless/high concurrency), use port 6543.
# For direct session connections or Alembic migrations, use port 5432.
#
# Examples:
# Direct:  postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Pooler:  postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT API & AUTHENTICATION KEYS
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
#
# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Project Public Anon API Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project Secret Service Role Key (NEVER expose to browser — backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (Found in: Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# ------------------------------------------------------------------------------
# 3. BACKEND API APPLICATION SETTINGS (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="Dentist on Call"
APP_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Application Security Keys (Min 32 characters)
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_chars_long
PASSWORD_RESET_SECRET=super_secret_password_reset_key_at_least_32_chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
DEFAULT_TIMEZONE=Africa/Cairo
