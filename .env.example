# ==============================================================================
# DENTIST ON CALL CAIRO — SUPABASE & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in the repository root and fill in your Supabase project keys.
# Project Dashboard: https://supabase.com/dashboard/project/<your-project-id>
#
# Generate secrets with:  openssl rand -hex 32
# Never commit a real .env file.

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Note: For transaction pooling (recommended for serverless/high concurrency), use port 6543.
# For direct session connections or Alembic migrations, use port 5432.
#
# Examples:
# Direct:  postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Pooler:  postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT API & AUTHENTICATION KEYS
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
#
# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Project Public Anon API Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY

# Project Secret Service Role Key (NEVER expose to browser — backend only)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

# Supabase JWT Secret (Found in: Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=REPLACE_ME_SUPABASE_JWT_SECRET

# ------------------------------------------------------------------------------
# 3. BACKEND API APPLICATION SETTINGS (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="Dentist on Call"
# Use "production" on hosted environments (disables OpenAPI, forces secure cookies)
APP_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Comma-separated extra browser origins (Vercel previews, etc.)
EXTRA_WEB_ORIGINS=
# Must be true behind HTTPS in production (auto-forced when APP_ENV=production)
COOKIE_SECURE=false
# For split-host deployments (e.g. Vercel frontend + separate API host) use:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# and set WEB_ORIGIN / EXTRA_WEB_ORIGINS to the exact frontend origin(s).
COOKIE_SAMESITE=lax

# Application Security Keys (Min 32 characters) — REPLACE before any shared/hosted use
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32_VALUE_HERE_XX
PASSWORD_RESET_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32_VALUE_HERE_YY
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
DEFAULT_TIMEZONE=Africa/Cairo

# Demo seeding (development only). Leave false unless you intentionally seed.
# Never enable SEED_DEMO_DATA when APP_ENV=production.
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
